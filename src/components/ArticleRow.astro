---
import type { Note } from '../lib/content';
import { topicLabel, kindLabel } from '../data/topics';
import { withBase } from '../lib/urls';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const href = withBase(`/notes/${note.data.slug}/`);
const kind = kindLabel(note.data.kind);
const date = note.data.publishedAt ?? '';
---

<a class="article-row" href={href} data-topics={note.data.topics.join(' ')} data-note>
  <span class="row-date">{date}</span>
  <div>
    <span class="small-category">
      {kind ? `${kind} · ` : ''}{note.data.topics.map((t) => topicLabel(t)).join(' / ')}
    </span>
    <h3>{note.data.title}</h3>
    <p class="summary">{note.data.description}</p>
  </div>
  <span class="row-side" aria-hidden="true">→</span>
</a>
